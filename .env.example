# Copy values into your deployment secret manager or process environment.
# The runtime never reads this file automatically.
AGENT_MODEL_PROVIDER=ark
AGENT_MODEL=ark-code-latest
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_API_KEY=
RUNTIME_SECRET_DEMO_MCP=local-demo-token
SPRING_PROFILES_ACTIVE=prod
RUNTIME_DB_URL=jdbc:mysql://oceanbase:2881/agent_runtime
RUNTIME_DB_USER=
RUNTIME_DB_PASSWORD=
OIDC_ISSUER=https://identity.example.com/realms/company
OIDC_AUDIENCE=agent-runtime
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
RUNTIME_SECRET_EMBEDDING=
RUNTIME_ALLOWED_ORIGINS=https://open.feishu.cn,https://ragflow.example.com,https://embedding.example.com,https://identity.example.com,https://orders.example.com
SANDBOX_ENABLED=false
SANDBOX_WORKER_URL=https://sandbox-worker.example.com
RUNTIME_SECRET_SANDBOX_WORKER=
